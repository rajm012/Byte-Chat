{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/impress-us/layout,_N_T_/impress-us/page,_N_T_/impress-us"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/impress-us/__PAGE__",
    "/impress-us",
    "/_index",
    "/_head"
  ]
}